GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL="AI Newsletter <newsletter@yourdomain.com>"

GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=9600
GEMINI_SUMMARY_OUTPUT_TOKENS=768
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_SECONDS=2
NEWSLETTER_TITLE="The TAP Brief"
NEWSLETTER_SUBJECT="The TAP Brief: Tech, AI, Product"
NEWSLETTER_DESCRIPTION="Tech · AI · Product - Explained simply every morning!"
NEWSLETTER_FOOTER_TEXT="Thank you for subscribing to the newsletter. If you run into any issues or have feedback, please reply to this email."
SUBSCRIBERS_CSV=subscribers.csv
MAX_ITEMS_PER_FEED=10
MAX_CANDIDATES_FOR_AI=40
MAX_STORIES_PER_SOURCE=2
NEWSLETTER_STORY_COUNT=8
MAX_STORY_AGE_HOURS=24
MIN_STORIES_TO_SEND=3
MIN_RELEVANCE_SCORE=10
HACKER_NEWS_MIN_RELEVANCE_SCORE=14
REQUIRE_CORE_RELEVANCE=true
SENT_HISTORY_FILE=sent_history.json
SENT_HISTORY_DAYS=45
INCLUDE_UNDATED_STORIES=false

# Optional feed overrides
TECHCRUNCH_RSS_URL=https://techcrunch.com/feed/
HACKER_NEWS_RSS_URL=https://news.ycombinator.com/rss
MIT_TECH_REVIEW_RSS_URL=https://www.technologyreview.com/feed/
LENNYS_NEWSLETTER_RSS_URL=https://www.lennysnewsletter.com/feed
THE_BATCH_RSS_URL=https://charonhub.deeplearning.ai/rss/
OPENAI_NEWS_RSS_URL=https://openai.com/news/rss.xml
ANTHROPIC_NEWS_RSS_URL=https://www.anthropic.com/news/rss.xml
GOOGLE_AI_BLOG_RSS_URL=https://blog.google/technology/ai/rss/
GOOGLE_CLOUD_AI_RSS_URL=https://cloud.google.com/blog/products/rss
GITHUB_AI_RSS_URL=https://github.blog/ai-and-ml/feed/
MICROSOFT_DEV_BLOG_RSS_URL=https://devblogs.microsoft.com/feed/
THE_NEW_STACK_RSS_URL=https://thenewstack.io/feed/
VENTUREBEAT_AI_RSS_URL=https://venturebeat.com/category/ai/feed/

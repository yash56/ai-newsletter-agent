GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL="AI Newsletter <newsletter@yourdomain.com>"

GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1600
NEWSLETTER_TITLE="AI, Agents, and Product Brief"
NEWSLETTER_SUBJECT="Today's AI, Agents, and Product Brief"
SUBSCRIBERS_CSV=subscribers.csv
MAX_ITEMS_PER_FEED=10
MAX_CANDIDATES_FOR_AI=40

# Optional feed overrides
TECHCRUNCH_RSS_URL=https://techcrunch.com/feed/
HACKER_NEWS_RSS_URL=https://news.ycombinator.com/rss
MIT_TECH_REVIEW_RSS_URL=https://www.technologyreview.com/feed/
LENNYS_NEWSLETTER_RSS_URL=https://www.lennysnewsletter.com/feed
THE_BATCH_RSS_URL=https://charonhub.deeplearning.ai/rss/
